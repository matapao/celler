{
  "name": "celler",
  "version": "0.7.0",
  "description": "An MCP gateway for agent harnesses: a published graph of cells and tools, with grants, delegation, an audit log and an approval inbox for everything that leaves the host",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matapao/celler.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.22.0 <13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run build && oxlint --type-aware --deny-warnings --report-unused-disable-directives src test scripts && knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --test --test-randomize --import ./test/setup.mjs test/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --test-randomize --import ./test/setup.mjs --experimental-test-coverage --test-coverage-include='dist/**' --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=75 test/*.test.mjs",
    "check:files": "node scripts/check-files.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:package": "pnpm run build && publint --strict && attw --pack . --profile esm-only",
    "github:settings": "node scripts/github-settings.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.330",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.171.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.3",
    "knip": "6.46.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
